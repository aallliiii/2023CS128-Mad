<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/splash_bg">

    <!-- Status bar spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/splash_bg" />

    <!-- Main center content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp">

        <!-- Glow rings + icon stacked -->
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginBottom="40dp">

            <!-- Outermost glow ring -->
            <View
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:background="@drawable/splash_glow_outer"
                android:layout_gravity="center" />

            <!-- Middle ring -->
            <View
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:background="@drawable/splash_glow_inner"
                android:layout_gravity="center" />

            <!-- Icon circle (dark card) -->
            <View
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/splash_icon_ring"
                android:layout_gravity="center" />

            <!-- App icon -->
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@mipmap/ic_launcher_round"
                android:contentDescription="@string/app_name" />

        </FrameLayout>

        <!-- Welcome text -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_welcome"
            android:textColor="@color/splash_text_muted"
            android:textSize="13sp"
            android:letterSpacing="0.25"
            android:textAllCaps="true"
            android:layout_marginBottom="8dp" />

        <!-- App name -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Three orange accent dots -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/splash_dots"
                android:layout_marginEnd="6dp" />

            <View
                android:layout_width="20dp"
                android:layout_height="6dp"
                android:background="@drawable/splash_dots" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/splash_dots"
                android:layout_marginStart="6dp" />

        </LinearLayout>

        <!-- Tagline -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_tagline"
            android:textColor="@color/splash_text_muted"
            android:textSize="14sp"
            android:letterSpacing="0.04"
            android:gravity="center" />

    </LinearLayout>

    <!-- Bottom area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="48dp">

        <!-- Thin top border line -->
        <View
            android:layout_width="60dp"
            android:layout_height="1dp"
            android:background="@color/splash_card"
            android:layout_marginBottom="20dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/color_accent"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOADING"
            android:textColor="#3D8B949E"
            android:textSize="10sp"
            android:letterSpacing="0.3"
            android:textAllCaps="true" />

    </LinearLayout>

</LinearLayout>
