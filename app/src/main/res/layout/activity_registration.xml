<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="56dp"
        android:paddingBottom="72dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REGISTRATION"
            android:textColor="@color/color_accent"
            android:textSize="11sp"
            android:letterSpacing="0.3"
            android:textAllCaps="true"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reg_title"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="28dp">
            <View
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:background="@color/color_accent"
                android:layout_marginEnd="10dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fill in the details below to register"
                android:textColor="@color/splash_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ── PERSONAL INFO card ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERSONAL INFO"
            android:textColor="@color/splash_text_muted"
            android:textSize="10sp"
            android:letterSpacing="0.25"
            android:textAllCaps="true"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/dark_card_bg"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <!-- Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hint_name"
                android:textColor="@color/splash_text_muted"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Enter your full name"
                android:textColorHint="#3D8B949E"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:inputType="textPersonName"
                android:imeOptions="actionNext"
                android:background="@drawable/dark_input_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="16dp" />

            <!-- Phone -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hint_phone"
                android:textColor="@color/splash_text_muted"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Enter your phone number"
                android:textColorHint="#3D8B949E"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:inputType="phone"
                android:imeOptions="actionNext"
                android:background="@drawable/dark_input_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="16dp" />

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hint_email"
                android:textColor="@color/splash_text_muted"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Enter your email address"
                android:textColorHint="#3D8B949E"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:background="@drawable/dark_input_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

        </LinearLayout>

        <!-- ── EVENT DETAILS card ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EVENT DETAILS"
            android:textColor="@color/splash_text_muted"
            android:textSize="10sp"
            android:letterSpacing="0.25"
            android:textAllCaps="true"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/dark_card_bg"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <!-- Event Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_event_type"
                android:textColor="@color/splash_text_muted"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerEventType"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/dark_input_bg"
                android:entries="@array/event_types"
                android:layout_marginBottom="16dp" />

            <!-- Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_date"
                android:textColor="@color/splash_text_muted"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvSelectedDate"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="@string/hint_date"
                    android:textColor="#3D8B949E"
                    android:textSize="14sp"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/dark_date_bg" />

                <Button
                    android:id="@+id/btnPickDate"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="@string/btn_pick_date"
                    android:textColor="@color/color_accent"
                    android:textSize="13sp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/outline_button_bg"
                    android:stateListAnimator="@null"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── PREFERENCES card ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PREFERENCES"
            android:textColor="@color/splash_text_muted"
            android:textSize="10sp"
            android:letterSpacing="0.25"
            android:textAllCaps="true"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/dark_card_bg"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <!-- Gender -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_gender"
                android:textColor="@color/splash_text_muted"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="10dp" />

            <RadioGroup
                android:id="@+id/rgGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <RadioButton
                    android:id="@+id/rbMale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/radio_male"
                    android:textColor="@color/white"
                    android:buttonTint="@color/color_accent" />

                <RadioButton
                    android:id="@+id/rbFemale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/radio_female"
                    android:textColor="@color/white"
                    android:buttonTint="@color/color_accent" />

                <RadioButton
                    android:id="@+id/rbOther"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/radio_other"
                    android:textColor="@color/white"
                    android:buttonTint="@color/color_accent" />

            </RadioGroup>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#21262D"
                android:layout_marginBottom="20dp" />

            <!-- Profile Photo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_photo"
                android:textColor="@color/splash_text_muted"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivProfilePreview"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/dark_image_preview"
                    android:contentDescription="@string/label_photo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Profile Photo"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JPG or PNG recommended"
                        android:textColor="@color/splash_text_muted"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnPickImage"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="@string/btn_pick_image"
                        android:textColor="@color/color_accent"
                        android:textSize="12sp"
                        android:background="@drawable/outline_button_bg"
                        android:stateListAnimator="@null"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Terms -->
        <CheckBox
            android:id="@+id/cbTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cb_terms"
            android:textColor="@color/splash_text_muted"
            android:textSize="13sp"
            android:buttonTint="@color/color_accent"
            android:layout_marginBottom="24dp" />

        <!-- Submit button -->
        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_submit"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:letterSpacing="0.05"
            android:background="@drawable/accent_button_bg"
            android:stateListAnimator="@null" />

    </LinearLayout>

</ScrollView>
